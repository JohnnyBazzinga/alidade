{
  "name": "@alidade/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Camera image, sighting session, readouts, map and simulator panel for Alidade.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:deep": "vitest run --config vitest.deep.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "vite --config playground/vite.config.ts",
    "build:playground": "vite build --config playground/vite.config.ts"
  },
  "dependencies": {
    "@alidade/core": "workspace:*",
    "@alidade/sensors": "workspace:*",
    "lucide-react": "1.70.0",
    "maplibre-gl": "6.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
